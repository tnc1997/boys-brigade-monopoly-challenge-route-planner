{
  "name": "boys-brigade-monopoly-challenge-route-planner",
  "version": "0.0.0",
  "private": true,
  "description": "An unofficial route planner for the Boys' Brigade Monopoly Challenge",
  "type": "module",
  "scripts": {
    "build": "tailwindcss --input tailwind.css --output styles.css --minify",
    "start": "concurrently --kill-others --names tailwind,serve \"tailwindcss --input tailwind.css --output styles.css --watch\" \"serve . --listen 3000\"",
    "test": "node --test \"*.test.js\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.3"
  }
}
